# Neon — Lakebase Postgres environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
#   cp .env.example .env
#
# ⚠️  This is a Vite app. Vite inlines only VITE_* into the browser
#     bundle; NEXT_PUBLIC_* (a Next.js convention) is IGNORED here.
#
# ⚠️  DATABASE_URL, AWS_SECRET_ACCESS_KEY, NEON_AI_GATEWAY_TOKEN and
#     JWT_SECRET must NEVER get a VITE_ prefix — they would ship to
#     the browser bundle.

# ── Postgres ───────────────────────────────────────────────────
# Pooled endpoint: use for application traffic (serverless / pooling).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?channel_binding=require&sslmode=require"

# Direct (non-pooled) endpoint - use for migrations and schema inspection.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?channel_binding=require&sslmode=require"

NEON_BRANCH=production

# ── S3-compatible object storage ───────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.REGION.aws.neon.tech

# ── Neon Auth ──────────────────────────────────────────────────
# Issuer is the full auth base URL, not just the host.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth/.well-known/jwks.json
NEON_AUTH_ISSUER="https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth"
NEON_AUTH_AUDIENCE="neondb"

# ── Neon Data API (PostgREST-compatible REST over Postgres) ────
NEON_DATA_API_URL=https://ep-xxxx.apirest.REGION.aws.neon.tech/DBNAME/rest/v1

# ── Neon AI Gateway ────────────────────────────────────────────
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=https://br-xxxx-api.ai.REGION.aws.neon.tech

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Session signing key. Rotate per environment and NEVER commit.
JWT_SECRET=

# Admin credentials for /admin/login. Set BOTH before production deploy.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# ═══════════════════════════════════════════════════════════════
# Client-exposed variables (VITE_*). Only non-secret endpoints +
# the S3 keys required for browser-direct uploads.
# ═══════════════════════════════════════════════════════════════

# ── S3 storage (consumed by src/NeonClient.tsx) ────────────────
VITE_NEON_S3_ENDPOINT=https://br-xxxx.storage.REGION.aws.neon.tech
VITE_NEON_S3_ACCESS_KEY_ID=
VITE_NEON_S3_SECRET_ACCESS_KEY=
VITE_NEON_S3_REGION=us-east-2
VITE_NEON_S3_BUCKET=media

# ── Public endpoint URLs (safe to expose client-side) ──────────
VITE_NEON_DATA_API_URL=https://ep-xxxx.apirest.REGION.aws.neon.tech/DBNAME/rest/v1
VITE_NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth
VITE_NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth/.well-known/jwks.json
VITE_NEON_AUTH_ISSUER=https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth
