# Neon — Lakebase Postgres environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
#   cp .env.example .env
#
# ⚠️  Vite only inlines VITE_* into the client bundle.
#     Never prefix secrets you don't want shipped to the browser.

# ── Postgres ───────────────────────────────────────────────────
# Pooled endpoint: use for application traffic (serverless / pooling).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Direct (non-pooled) endpoint: use for migrations and schema inspection.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Branch this deployment targets.
NEON_BRANCH=production

# ── S3-compatible object storage ───────────────────────────────
AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.REGION.aws.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"

# Neon Data API (PostgREST-compatible REST over Postgres).
NEON_DATA_API_URL="https://ep-xxxx.apirest.REGION.aws.neon.tech/DBNAME/rest/v1"

# Neon Auth.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth"
NEON_AUTH_JWKS_URL="https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth/.well-known/jwks.json"

# ═══════════════════════════════════════════════════════════════
# Client-exposed variables (VITE_*). Only non-secret endpoints +
# the S3 keys required for browser-direct uploads.
# Do NOT add VITE_ to DATABASE_URL or the DB password.
# ═══════════════════════════════════════════════════════════════

# ── S3 storage (consumed by src/NeonClient.tsx) ────────────────
VITE_NEON_S3_ENDPOINT=https://br-xxxx.storage.REGION.aws.neon.tech
VITE_NEON_S3_ACCESS_KEY_ID=
VITE_NEON_S3_SECRET_ACCESS_KEY=
VITE_NEON_S3_REGION=us-east-2
VITE_NEON_S3_BUCKET=media

# ── Public endpoint URLs (safe to expose client-side) ──────────
VITE_NEON_DATA_API_URL=https://ep-xxxx.apirest.REGION.aws.neon.tech/DBNAME/rest/v1
VITE_NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth
VITE_NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/DBNAME/auth/.well-known/jwks.json
